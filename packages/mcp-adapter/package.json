{
  "name": "@game-interaction-sop/mcp-adapter",
  "version": "0.2.0",
  "description": "FigmaBackend implementations that delegate to a user-supplied `exec(code)` function — typically wired to a figma-console (or compatible) MCP `figma_execute` tool by the calling AI agent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@game-interaction-sop/engine": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "figma",
    "mcp",
    "figma-console",
    "interaction-doc"
  ],
  "license": "MIT"
}
