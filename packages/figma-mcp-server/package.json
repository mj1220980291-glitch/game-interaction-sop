{
  "name": "figma-interaction-doc-engine",
  "version": "0.2.0",
  "description": "Deterministic engine that turns v2 interaction-doc Markdown into Figma documents via figma-console-mcp.",
  "type": "module",
  "private": true,
  "bin": {
    "figma-interaction-doc-engine": "./bin/figma-interaction-doc-engine.js"
  },
  "main": "./dist/server/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./v2": "./dist/v2/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-istanbul": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
