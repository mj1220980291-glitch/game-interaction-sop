{
  "name": "figma-interaction-doc-engine",
  "version": "0.1.0",
  "description": "Deterministic engine that turns interaction-doc DSL (YAML) into Figma documents via figma-console-mcp.",
  "type": "module",
  "private": true,
  "bin": {
    "figma-interaction-doc-engine": "./bin/figma-interaction-doc-engine.js"
  },
  "main": "./dist/server/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./dsl": "./dist/dsl/index.js",
    "./parser": "./dist/parser/index.js",
    "./planner": "./dist/planner/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:templates": "vitest run tests/lint-templates.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@vitest/coverage-istanbul": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.8",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
